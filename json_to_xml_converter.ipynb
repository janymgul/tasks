   "source": [
    "from flask import Flask, request, Response\n",
    "import dicttoxml\n",
    "\n",
    "app = Flask(__name__)\n",
    "\n",
    "@app.route(\"/convert\", methods=[\"POST\"])\n",
    "def convert_json_to_xml():\n",
    "    data = request.json\n",
    "    xml = dicttoxml.dicttoxml(data)\n",
    "    return Response(xml, mimetype='application/xml')\n",
    "\n",
    "app.run()"
   ]
  },
